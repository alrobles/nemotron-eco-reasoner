Bootstrap: docker
From: nvidia/cuda:12.4.0-devel-ubuntu22.04

%labels
    Author Angel Luis Robles Fernandez <a.l.robles.fernandez@gmail.com>
    Description Nemotron-3-Nano training (CUDA 12.4, A100)
    All packages from conda-forge — guaranteed compatibility

%environment
    export HF_HUB_DISABLE_PROGRESS_BARS=1
    export PYTHONUNBUFFERED=1

%post
    set -e

    # Install miniconda
    apt-get update -qq && apt-get install -y -qq wget 2>&1 | tail -1
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda 2>&1 | tail -1
    rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH

    # Accept conda ToS
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main 2>/dev/null || true
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r 2>/dev/null || true

    # Install everything from conda-forge — torch + mamba-ssm as one atomic solve
    echo "=== Installing PyTorch + mamba-ssm via conda-forge ==="
    conda install -y -c conda-forge \
        python=3.10 \
        pytorch=2.5.1 \
        pytorch-cuda=12.4 \
        mamba-ssm \
        causal-conv1d \
        transformers \
        datasets \
        accelerate \
        peft \
        sentencepiece \
        2>&1 | tail -10

    # Verify core
    python3 -c "
import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.version.cuda}')
import mamba_ssm; print('mamba-ssm: OK')
import causal_conv1d; print('causal-conv1d: OK')
"

    # TRL via pip (conda-forge version may be outdated)
    pip install --quiet --progress-bar off --no-cache-dir trl==0.24.0

    # Optional
    pip install --quiet --progress-bar off --no-cache-dir wandb tensorboard

    # Final verification
    echo "=== Verification ==="
    python3 -c "
import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.version.cuda}')
import mamba_ssm; print('mamba-ssm: OK')
import transformers; print(f'transformers {transformers.__version__}')
import peft; print(f'peft {peft.__version__}')
import trl; print(f'trl {trl.__version__}')
import accelerate; print(f'accelerate {accelerate.__version__}')
print('ALL CHECKS PASSED')
"

%runscript
    exec python3 "$@"
