Bootstrap: docker
From: kirakira2024/mamba2:ssm2.2.6_torch2.5_py3.11

%labels
    Author Angel Luis Robles Fernandez
    Description Nemotron-3-Nano training (CUDA 12.4, A100)
    Base: kirakira2024/mamba2 — mamba-ssm 2.2.6 + PyTorch 2.5.1 pre-compiled

%environment
    export HF_HUB_DISABLE_PROGRESS_BARS=1
    export PYTHONUNBUFFERED=1

%post
    set -e

    echo "=== Base ==="
    python3 -c "import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.version.cuda}')"
    python3 -c "import mamba_ssm; print(f'mamba-ssm OK')"
    python3 -c "import causal_conv1d; print(f'causal-conv1d {causal_conv1d.__version__}')"

    echo "=== Training stack ==="
    pip install --quiet --progress-bar off --no-cache-dir \
        transformers==4.57.6 \
        peft==0.17.1 \
        trl==0.24.0 \
        datasets==4.5.0 \
        accelerate==1.10.1 \
        sentencepiece==0.2.1

    echo "=== Verification ==="
    python3 -c "
import torch; print(f'PyTorch {torch.__version__}')
import mamba_ssm; print('mamba-ssm: OK')
import transformers; print(f'transformers {transformers.__version__}')
import peft; print(f'peft {peft.__version__}')
import trl; print(f'trl {trl.__version__}')
print('ALL CHECKS PASSED')
"

%runscript
    exec python3 "$@"
