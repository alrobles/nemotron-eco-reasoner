Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel

%labels
    Author Angel Luis Robles Fernandez <a.l.robles.fernandez@gmail.com>
    Description Nemotron-3-Nano BF16 LoRA/DoRA training (CUDA 12.4, A100)
    mamba-ssm via conda-forge — zero compilation, pre-built binaries

%environment
    export HF_HUB_DISABLE_PROGRESS_BARS=1
    export PYTHONUNBUFFERED=1

%post
    set -e

    echo "=== CUDA: $(nvcc --version 2>/dev/null | tail -1 || echo 'not found') ==="
    echo "=== PyTorch: $(python3 -c 'import torch; print(torch.__version__)') ==="

    # mamba-ssm from conda-forge — pre-compiled, zero dependency hell
    # conda resolves torch/triton/cuda compatibility automatically
    echo "=== Installing mamba-ssm via conda-forge ==="
    conda install -y -c conda-forge mamba-ssm 2>&1 | tail -5
    python3 -c "import mamba_ssm; print('mamba-ssm OK')"

    # causal-conv1d — also via conda-forge
    echo "=== Installing causal-conv1d via conda-forge ==="
    conda install -y -c conda-forge causal-conv1d 2>&1 | tail -5 || echo "(optional, continuing)"
    python3 -c "import causal_conv1d; print('causal-conv1d OK')" 2>/dev/null || echo "(not available)"

    # Training stack via pip (conda versions may be outdated)
    pip install --quiet --progress-bar off --no-cache-dir \
        transformers==4.57.6 \
        peft==0.17.1 \
        trl==0.24.0 \
        datasets==4.5.0 \
        accelerate==1.10.1 \
        sentencepiece==0.2.1 \
        wandb \
        tensorboard

    # Final verification
    echo "=== Verification ==="
    python3 -c "
import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.version.cuda}')
import mamba_ssm; print('mamba-ssm: OK')
import transformers; print(f'transformers {transformers.__version__}')
import peft; print(f'peft {peft.__version__}')
import trl; print(f'trl {trl.__version__}')
import accelerate; print(f'accelerate {accelerate.__version__}')
print('ALL CHECKS PASSED')
"

%runscript
    exec python3 "$@"
